# Owner/superuser connection: used only for migrations and seeding.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/tapserve
# Application connection: the restricted tapserve_app role, which is subject to row-level security.
DATABASE_URL=postgres://tapserve_app:tapserve_app@localhost:5432/tapserve
# Password the migration sets for the tapserve_app role (change in production).
APP_DB_PASSWORD=tapserve_app
# SMS provider for phone OTP: "console" logs codes to the server output (development only).
SMS_PROVIDER=console
